# Copy to .env and fill in. Nothing here is required for `make reproduce`.

# --- Kaggle (only for `make fetch`) -----------------------------------------
# Current flow: kaggle.com -> Settings -> API -> Generate New Token, then
# echo the KGAT_ token into ~/.kaggle/access_token. The vars below are legacy.
# That downloads a kaggle.json containing both values.
# Alternative: skip these entirely and use `python tools/fetch_dataset.py --zip <path>`
# after downloading the dataset manually in a browser.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Local models via Ollama (only for `make generate` / `make judge`) ------
OLLAMA_HOST=http://localhost:11434

# Generator and judge are deliberately DIFFERENT model families. A judge from
# the same family as the generator shows self-preference bias and inflates the
# reply-quality score. See DECISIONS.md.
GEN_MODEL=qwen2.5:3b-instruct
JUDGE_MODEL=llama3.2:3b

# Embedding model (HuggingFace id, downloaded on first use, ~90MB)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Reproducibility ---------------------------------------------------------
SEED=20260909
